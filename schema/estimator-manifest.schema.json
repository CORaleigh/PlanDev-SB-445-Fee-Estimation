{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raleighnc.gov/schemas/permit-fee-estimator/manifest-v1.schema.json",
  "title": "Permit Fee Estimator Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generatedAtUtc",
    "configurationAsOfDate",
    "sourceAuthority",
    "disclosureCodesPath",
    "options"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "configurationAsOfDate": {
      "type": "string",
      "format": "date"
    },
    "sourceAuthority": {
      "const": "EnerGov"
    },
    "disclosureCodesPath": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "optionKey",
          "permitType",
          "workClass",
          "path",
          "validationStatus"
        ],
        "properties": {
          "optionKey": {
            "type": "string",
            "minLength": 1
          },
          "permitType": {
            "type": "string",
            "minLength": 1
          },
          "workClass": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "validationStatus": {
            "type": "string",
            "enum": [
              "validated",
              "partially-validated",
              "unvalidated",
              "blocked"
            ]
          }
        }
      }
    }
  }
}
